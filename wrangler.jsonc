{
  // Without this file the Cloudflare Worker had nothing telling it what to
  // serve, so it ran the default "Hello world" template — expresscoupon.info
  // returned 11 bytes for days while the repo held a complete site and every
  // deploy reported success.
  //
  // `assets.directory` points at the Next.js static export (next.config.mjs sets
  // output:'export'), which is what makes a Worker serve the built site instead
  // of a script response.
  //
  // The build command itself lives in the Cloudflare dashboard, under
  // Workers & Pages -> expresscoupon -> Settings -> Build:
  //   Build command:      npm run build
  //   Deploy command:     npx wrangler deploy
  "name": "expresscoupon",
  "compatibility_date": "2026-08-10",
  // src/worker.ts only ever sees NON-asset paths (/go/*): with no
  // run_worker_first set, static assets are served before the script runs, so
  // adding `main` cannot change how any existing page is served.
  "main": "src/worker.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  // Deliberately the SAME database racksontop's sensor writes to, so one
  // /go-stats call at racksontop.me covers the whole estate. Rows from here
  // carry site='expresscoupon'. The name is racksontop's only because that is
  // where the sensor was built first.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "racksontop-clicks",
      "database_id": "07174c41-7f1c-418f-8dcc-67e012c54d12"
    }
  ]
}
